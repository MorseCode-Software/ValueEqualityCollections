<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net6.0;net472</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <TestingPlatformDotnetTestSupport>rrue</TestingPlatformDotnetTestSupport>
        <LangVersion>latest</LangVersion>
        <!-- TUnit's own transitive dependencies don't list net6.0 as officially tested; their netstandard2.0 assets work fine. -->
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        <!-- net6.0 is targeted deliberately alongside net472; both are supported build targets for this library. -->
        <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
        <EnableDefaultItems>false</EnableDefaultItems>
        <TUnitImplicitUsings>disable</TUnitImplicitUsings>
        <TUnitAssertionsImplicitUsings>disable</TUnitAssertionsImplicitUsings>
        <TUnitMockImplicitUsings>disable</TUnitMockImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>MorseCode.Collections.ValueEquality.UnitTests</RootNamespace>
        <Title>Value Equality Collections</Title>
        <Authors>MorseCode Software LLC</Authors>
        <Description>Unit tests for MorseCode.Collections.ValueEquality.</Description>
    </PropertyGroup>

    <!-- Microsoft.Testing.Platform generates a native apphost for net472, which requires an explicit RuntimeIdentifier. -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'net472' ">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" Version="1.65.68" />
        <PackageReference Include="TUnit.Mocks" Version="1.65.68" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MorseCode.Collections.ValueEquality\MorseCode.Collections.ValueEquality.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="FrozenDictionaryWithValueEqualityTests.cs"/>
        <Compile Include="FrozenListWithValueEqualityTests.cs"/>
        <Compile Include="FrozenQueueWithValueEqualityTests.cs"/>
        <Compile Include="FrozenSetWithValueEqualityTests.cs"/>
        <Compile Include="FrozenStackWithValueEqualityTests.cs"/>
        <Compile Include="GlobalSetup.cs"/>
        <Compile Include="Polyfills.cs"/>
        <Compile Include="ImmutableDictionaryWithValueEqualityTests.cs"/>
        <Compile Include="ImmutableListWithValueEqualityTests.cs"/>
        <Compile Include="ImmutableQueueWithValueEqualityTests.cs"/>
        <Compile Include="ImmutableSetWithValueEqualityTests.cs"/>
        <Compile Include="ImmutableStackWithValueEqualityTests.cs"/>
        <Compile Include="ReadOnlyDictionaryWithValueEqualityTests.cs"/>
        <Compile Include="ReadOnlyListWithValueEqualityTests.cs"/>
        <Compile Include="ReadOnlyQueueWithValueEqualityTests.cs"/>
        <Compile Include="ReadOnlySetWithValueEqualityTests.cs"/>
        <Compile Include="ReadOnlyStackWithValueEqualityTests.cs"/>
    </ItemGroup>

</Project>
