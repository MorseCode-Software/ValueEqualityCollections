<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net6.0;net472;netstandard2.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <!--
            System.Collections.Immutable does not list net6.0 among its officially tested targets, but its
            netstandard2.0 asset (which net6.0 resolves to) has been verified to include the Frozen collection
            and CollectionBuilderAttribute support this library relies on.
        -->
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        <EnableDefaultItems>false</EnableDefaultItems>
        <Nullable>enable</Nullable>
        <RootNamespace>MorseCode.Collections.ValueEquality</RootNamespace>
		<MinVerTagPrefix>collections-value-equality-</MinVerTagPrefix>
        <Title>Value Equality Collections</Title>
        <Description>Collection interfaces and implementations which use value equality.</Description>
        <PackageId>MorseCode.Collections.ValueEquality</PackageId>
        <Product>Value Equality Collections</Product>
        <AssemblyName>MorseCode.Collections.ValueEquality</AssemblyName>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DocumentationFile>bin\Debug\MorseCode.Collections.ValueEquality.xml</DocumentationFile>
        <DebugType>pdbonly</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DocumentationFile>bin\Release\MorseCode.Collections.ValueEquality.xml</DocumentationFile>
        <DebugType>pdbonly</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <!--
        On net472 and netstandard2.0, IReadOnlyDictionary<TKey,TValue> comes from a reference assembly built
        without nullable reference type annotations, so the compiler cannot match its (unannotated) TryGetValue
        signature against this library's (annotated) implementation. This is an unavoidable consequence of
        targeting those frameworks under #nullable enable, not an actual nullability bug.
    -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'net472' Or '$(TargetFramework)' == 'netstandard2.0' ">
        <NoWarn>$(NoWarn);CS8767</NoWarn>
    </PropertyGroup>

    <!--
        On net6.0, doc-comment cref resolution for IReadOnlySet{T} reports a spurious ambiguity against itself
        (confirmed there is no duplicate type in the compiled output); this is purely a doc-generation quirk with
        no effect on behavior.
    -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'net6.0' ">
        <NoWarn>$(NoWarn);CS0419</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="IFrozenDictionaryWithValueEquality.cs"/>
        <Compile Include="IFrozenListWithValueEquality.cs"/>
        <Compile Include="IFrozenQueueWithValueEquality.cs"/>
        <Compile Include="IFrozenSetWithValueEquality.cs"/>
        <Compile Include="IFrozenStackWithValueEquality.cs"/>
        <Compile Include="IImmutableDictionaryWithValueEquality.cs"/>
        <Compile Include="IImmutableListWithValueEquality.cs"/>
        <Compile Include="IImmutableQueueWithValueEquality.cs"/>
        <Compile Include="IImmutableSetWithValueEquality.cs"/>
        <Compile Include="IImmutableStackWithValueEquality.cs"/>
        <Compile Include="IReadOnlyDictionaryWithValueEquality.cs"/>
        <Compile Include="IReadOnlyListWithValueEquality.cs"/>
        <Compile Include="IReadOnlyQueueWithValueEquality.cs"/>
        <Compile Include="IReadOnlySetWithValueEquality.cs"/>
        <Compile Include="IReadOnlyStackWithValueEquality.cs"/>
        <Compile Include="Polyfills.cs"/>
        <Compile Include="ValueEqualityCollectionFactory.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
        <PackageReference Include="System.Collections.Immutable" Version="10.0.11" />
    </ItemGroup>

</Project>
